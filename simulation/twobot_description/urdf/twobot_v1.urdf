<?xml version="1.0"?>
<robot name="twobot">

  <link name="world"/>

  <joint name="fixed_to_world" type="fixed">
    <parent link="world"/>
    <child link="link_0_base"/>
    <origin xyz="0 0 1.1" rpy="0 1.5708 0"/> 
  </joint>

  <link name="link_0_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://twobot_description/meshes/fine/link0_fine.STL"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.2 -0.2 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.18632 -0.09818 0.04623" rpy="0 0 0"/>
      <mass value="3.81656"/> 
      <inertia 
        ixx="0.04019" ixy="-0.00813" ixz="-0.04059" 
        iyy="0.17450" iyz="-0.00287" 
        izz="0.17554"/> 
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="link_0_base"/>
    <child link="link_1_elbow"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="2.44" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_1_elbow">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://twobot_description/meshes/fine/link1_fine.STL"/>
      </geometry>
      <material name="exo_blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0.1" rpy="0 1.5708 0"/> 
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.20642 -0.00001 0.09074" rpy="0 0 0"/> 
      <mass value="2.06236"/> 
      <inertia 
        ixx="0.00750" ixy="0.00000" ixz="-0.00161" 
        iyy="0.05296" iyz="0.00000" 
        izz="0.05247"/> 
    </inertial>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="link_1_elbow"/>
    <child link="link_2_wrist"/>
    <origin xyz="0.33 0 0" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50.0" velocity="5.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="link_2_wrist">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://twobot_description/meshes/fine/link2_fine.STL"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00002 -0.00669 0.02081" rpy="0 0 0"/>
      <mass value="0.47720"/>
      <inertia 
        ixx="0.00215" ixy="0.00000" ixz="-0.00000" 
        iyy="0.00197" iyz="0.00015" 
        izz="0.00162"/>
    </inertial>
  </link>


<ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="elbow_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">2.44</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_joint">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find twobot_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>



</robot>
